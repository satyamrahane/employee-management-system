# Copy to .env and replace the JWT placeholder before enabling authentication.
# Never commit real credentials or secrets.

APP_ENV=development
DATABASE_URL=sqlite:///./ems_dev.db

# Generate a unique random value of at least 32 bytes for any deployment
# where authentication is enabled. This placeholder is not a valid secret.
AUTH_JWT_SECRET_KEY=replace-with-at-least-32-random-bytes

# Browser authentication requests are rejected unless their Origin is listed.
AUTH_TRUSTED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]

# Local HTTP development only; use secure cookies over HTTPS in deployments.
AUTH_COOKIE_SECURE=false
